# ============================================================
# 环境变量模板：复制本文件为 .env 并填入真实值
#   cp .env.example .env        (Linux/macOS)
#   copy .env.example .env      (Windows)
# .env 已被 .gitignore 排除，请勿提交真实密钥
# ============================================================

# LLM API 密钥（AI 分析功能必需）
AGNES_API_KEY=your_api_key_here

# LLM API 端点地址
AGNES_BASE_URL=your_base_url_here
